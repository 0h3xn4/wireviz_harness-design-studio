<!--
SPDX-FileCopyrightText: 2026 0h3xn4
SPDX-License-Identifier: FSFAP

The AppStream data of Harness Design Studio: the page of the program in Ubuntu's App Center and
other software centres. The .deb installs the finished file as
/usr/share/metainfo/io.github._0h3xn4.harness_design_studio.metainfo.xml, the install.sh of the
tarball under ~/.local/share/metainfo/. The releases are filled in at build time from
CHANGELOG.md and docs/releases/ (python -m tools.appstream write FILE). The screenshots are
loaded by the software centre from the web; the program itself never uses the network.
-->
<component type="desktop-application">
  <id>io.github._0h3xn4.harness_design_studio</id>
  <metadata_license>FSFAP</metadata_license>
  <project_license>GPL-3.0-only</project_license>
  <name>Harness Design Studio</name>
  <summary>Design the electrical harnesses of a spacecraft, offline</summary>
  <description>
    <p>Harness Design Studio is a desktop tool for the electrical harnesses of a spacecraft. You describe the devices and the interfaces between them; the tool generates the harnesses (connectors, pins and wires, with a reason for each choice), checks them against design rules and writes drawings, wire lists, test tables and a build workbook.</p>
    <p>The same design gives byte-identical files with the same version of the tool, so Git shows real changes only. A released harness keeps a record of its revisions.</p>
    <p>The program never uses the network. It ships no engineering values of its own: each project supplies them, and every result must be checked before a harness is built.</p>
  </description>
  <developer id="io.github._0h3xn4">
    <name>0h3xn4</name>
  </developer>
  <url type="homepage">https://github.com/0h3xn4/wireviz_harness-design-studio</url>
  <url type="bugtracker">https://github.com/0h3xn4/wireviz_harness-design-studio/issues</url>
  <launchable type="desktop-id">harness-design-studio.desktop</launchable>
  <icon type="stock">harness-design-studio</icon>
  <categories>
    <category>Engineering</category>
    <category>Science</category>
  </categories>
  <keywords>
    <keyword>harness</keyword>
    <keyword>wiring</keyword>
    <keyword>spacecraft</keyword>
  </keywords>
  <provides>
    <binary>harness-design-studio-gui</binary>
    <binary>harness-design-studio</binary>
    <binary>harness</binary>
  </provides>
  <content_rating type="oars-1.1"/>
